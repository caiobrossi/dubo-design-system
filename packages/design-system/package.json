{
  "name": "dubo-design-system",
  "version": "0.1.0",
  "description": "Dubo design tokens and accessible React components for calm, precise clinical software.",
  "license": "UNLICENSED",
  "author": "Dubo",
  "homepage": "https://github.com/caiobrossi/dubo-design-system#readme",
  "bugs": {
    "url": "https://github.com/caiobrossi/dubo-design-system/issues"
  },
  "keywords": [
    "design-system",
    "react",
    "react-18",
    "figma-make",
    "vite",
    "typescript",
    "accessibility",
    "healthcare",
    "dental"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caiobrossi/dubo-design-system.git",
    "directory": "packages/design-system"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "figma-make"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components/ui/*": {
      "types": "./dist/components/ui/*.d.ts",
      "import": "./dist/components/ui/*.js",
      "default": "./dist/components/ui/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js",
      "default": "./dist/lib/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./styles/badge-info3-tokens.css": "./dist/styles/badge-info3-tokens.css",
    "./styles/figma-make.css": "./dist/styles/figma-make.css",
    "./styles/theme.css": "./dist/styles/theme.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run clean && pnpm exec tsc -p tsconfig.build.json && pnpm run fix:esm && pnpm run generate:theme && cp src/styles/badge-info3-tokens.css dist/styles/badge-info3-tokens.css && pnpm run generate:figma-css",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "fix:esm": "node scripts/fix-esm-imports.mjs",
    "generate:figma-css": "node scripts/generate-figma-css.mjs",
    "generate:theme": "pnpm exec tsx scripts/generate-theme.mjs",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck",
    "typecheck": "pnpm exec tsc -p tsconfig.build.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^20.19.37",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.542.0",
    "libphonenumber-js": "^1.12.40",
    "next-themes": "^0.4.6",
    "react-day-picker": "^10.0.1",
    "react-phone-number-input": "^3.4.16",
    "react-resizable-panels": "^4.7.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  }
}
